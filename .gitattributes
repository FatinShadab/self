# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit LF for code, documentation, scripts, and data
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# PowerShell scripts on Windows
*.ps1 text eol=crlf
