      },
      "limits": {
        "max_iterations": 4,
        "token_budget": 30000,
        "wall_clock_seconds": 300,
        "max_provider_calls": 12
      },
      "verifier": {
        "kind": "facts",
        "path": "ab_outputs/extract_policy.json",
        "expected": {
          "owner": "Mira Chen",
          "deadline": "2026-11-03",
          "action": "rotate staging API key"
        },
        "summary_facts": [
          "staging",
          "audit log"
        ]
      }
    },
