# Copy this file to .env on the host. Never commit .env.
# Ollama's official variable names are preferred. OLLAM_* aliases also work.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAM_API_KEY=
OLLAM_BASE_URL=
OLLAM_MODEL=

# Optional provider keys. Add only keys you obtained yourself; never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional local Ollama endpoint already reachable from inside the container.
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434
GITHUB_TOKEN=
HUMAN_CONTACT=

# Phase 2 runtime limits.
SELF_MAX_ITERATIONS=20
SELF_TOKEN_BUDGET=50000
SELF_MAX_OUTPUT_CHARS=20000
# Hard ceilings enforced by the harness; daily token use persists across restarts.
SELF_MAX_TOKENS_PER_DAY=200000
SELF_MAX_WALL_CLOCK_SECONDS=1800
