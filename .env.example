# Copy this file to .env on the host. Never commit .env.
# Ollama's official variable names are preferred. OLLAM_* aliases also work.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAM_API_KEY=
OLLAM_BASE_URL=
OLLAM_MODEL=

# Optional provider keys. Add only keys you obtained yourself; never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional local Ollama endpoint already reachable from inside the container.
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434
GITHUB_TOKEN=
HUMAN_CONTACT=

# Optional local voice output. Defaults to off; use /voice on in the TUI.
# Native Windows runs prefer the first installed female System.Speech voice.
# Docker on Windows cannot access the host speaker directly.
# SELF_VOICE_ENABLED=1

# Phase 2 runtime limits.
SELF_MAX_ITERATIONS=0
# 0 means run until the daily token ledger is exhausted or /stop is requested.
SELF_MAX_WALL_CLOCK_SECONDS=0
# 0 means one chat may use the remaining daily cap by default.
SELF_TOKEN_BUDGET=0
# Retained for compatibility; daily-only mode no longer needs adaptive expansion.
SELF_ADAPTIVE_TOKEN_BUDGET=1
# Legacy optional ceiling; leave unset for daily-only mode.
# SELF_MAX_ADAPTIVE_TOKEN_BUDGET=200000
SELF_MAX_OUTPUT_CHARS=20000
# Maximum simultaneous read-only conversation replies while autonomous work runs.
SELF_MAX_CONVERSATION_WORKERS=2
# Maximum response tokens reserved by each conversation thread.
SELF_CONVERSATION_MAX_TOKENS=1200
# Daily token use persists across restarts.
SELF_MAX_TOKENS_PER_DAY=200000
