# Copy to .env and add your own key. Keep .env private.
# Primary provider: use an Ollama Cloud API key.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud

# Optional: Ollama Cloud models available to the same key, separated by commas.
# LLM_AVAILABLE_MODELS=

# Optional probe limits (defaults shown). Zero cooldown allows immediate re-probing.
# SELF_PROBE_COOLDOWN_SECONDS=3600
# SELF_PROBES_PER_MODEL_PER_SESSION=2
# SELF_MODEL_FAILURE_COOLDOWN_SECONDS=600
# SELF_CRITIC_SHADOW_TESTS=true

# Helper-model A/B arms. Keep on for normal use; the A/B runner sets these per run.
# SELF_HELPER_MODELS=on
# SELF_CRITIC_MODEL=
# SELF_MAX_PROVIDER_CALLS=0

# Optional: change the daily token ceiling (default: 200000).
# SELF_MAX_TOKENS_PER_DAY=200000

# To use Anthropic instead, leave OLLAMA_API_KEY empty and set both below.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ──────────────────────────────────────────────────────────────────────────────
# Opencode (optional coding-agent CLI)
# These are namespaced to avoid collisions with Self's own provider keys.
# The Self wrapper maps these to the standard variable names opencode expects
# (GROQ_API_KEY, GEMINI_API_KEY, HF_TOKEN) when invoking the opencode process.
# ──────────────────────────────────────────────────────────────────────────────
OPENCODE_GROQ_API_KEY=
OPENCODE_GOOGLE_API_KEY=
OPENCODE_HF_TOKEN=

# Set to 1 and provide at least one key above to enable the live smoke test.
# OPENCODE_SMOKE_LIVE=0
